{
  "name": "hopi-agent-orchestrator-root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": ["packages/backend", "packages/frontend"],
  "scripts": {
    "dev:backend": "cd packages/backend && bun start",
    "restart:backend": "bun run scripts/restart-backend.ts",
    "dev:backend:watch": "cd packages/backend && bun dev",
    "dev:frontend": "cd packages/frontend && bun dev",
    "remote:frontend": "cd packages/frontend && bun run remote",
    "reset:home": "bun run scripts/reset-home.ts",
    "reset:project": "bun run scripts/reset-project.ts",
    "migrate:home-schema-2": "bun run scripts/migrate-home-schema-2.ts",
    "dev": "bun run verify:runtime && bun run dev:backend",
    "test:contract": "cd packages/backend && bun test tests/runAttemptStore.test.ts tests/roleRunner.test.ts tests/roleContextStager.test.ts tests/projectReconciler.test.ts tests/coordinatorReconciler.test.ts tests/c1Integrator.test.ts tests/multiRepoC1.test.ts tests/assistantTools.test.ts tests/assistantWake.test.ts tests/workspaceAssistant.test.ts tests/mvpServer.test.ts",
    "e2e:contract": "bun run test:contract",
    "test:browser": "cd packages/backend && bun run tests/browser/globalAssistant.browser.ts",
    "e2e:browser:029": "cd packages/backend && bun run tests/browser/assistantProviderError.browser.ts",
    "e2e:config:020": "cd packages/backend && bun run tests/e2e/configurationRebind.e2e.ts",
    "e2e:relocation:030": "cd packages/backend && bun run tests/e2e/projectRelocation.e2e.ts",
    "e2e:webhook:025": "cd packages/backend && bun run tests/e2e/webhookDelivery.e2e.ts",
    "e2e:preflight": "bun run e2e:contract && bun run test:browser",
    "e2e:live": "cd packages/backend && bun run tests/live/goalDelivery.live.ts",
    "e2e:live:010": "cd packages/backend && bun run tests/live/conversationBoundary.live.ts",
    "e2e:live:011": "cd packages/backend && bun run tests/live/concurrentProjects.live.ts",
    "e2e:live:013": "cd packages/backend && bun run tests/live/blockingAttention.live.ts",
    "e2e:live:016": "cd packages/backend && bun run tests/live/processRestart.live.ts",
    "e2e:live:017": "cd packages/backend && bun run tests/live/multiRepoBootstrap.live.ts",
    "e2e:live:019": "cd packages/backend && bun run tests/live/wakeNotification.live.ts",
    "e2e:live:022": "cd packages/backend && bun run tests/live/multimodalDelivery.live.ts",
    "e2e:live:022:conversation": "cd packages/backend && bun run tests/live/conversationImage.live.ts",
    "e2e:live:026": "cd packages/backend && bun run tests/live/longConversationRecovery.live.ts",
    "e2e:live:028": "cd packages/backend && bun run tests/live/projectAttentionRecovery.live.ts",
    "e2e:live:032": "cd packages/backend && bun run tests/live/preferenceJudgment.live.ts",
    "e2e:live:033": "cd packages/backend && bun run tests/live/environmentJudgment.live.ts",
    "e2e:live:035": "cd packages/backend && bun run tests/live/previewAutonomousDelivery.live.ts",
    "e2e:regression": "cd packages/backend && bun run tests/e2e/regression.ts",
    "e2e:regression:live": "cd packages/backend && bun run tests/e2e/regression.ts --live",
    "e2e": "bun run e2e:preflight && bun run e2e:live",
    "artifact:inspect": "bun run packages/backend/tests/live/inspectGoalDeliveryArtifact.ts",
    "artifact:inspect:011": "bun run packages/backend/tests/live/inspectConcurrentProjectsArtifact.ts",
    "artifact:inspect:022": "bun run packages/backend/tests/live/inspectMultimodalArtifact.ts",
    "artifact:summary": "bun run packages/backend/tests/e2e/artifactSummary.ts",
    "artifact:review": "bun run packages/backend/tests/e2e/recordArtifactReview.ts",
    "build:frontend": "cd packages/frontend && bun run build",
    "verify:runtime": "bun run scripts/verify-runtime.ts",
    "check": "bun run verify:runtime && bun test scripts/verify-runtime.test.ts && bun run check:backend && bun run check:frontend",
    "check:backend": "cd packages/backend && bun run check",
    "check:frontend": "cd packages/frontend && bun run check"
  }
}
